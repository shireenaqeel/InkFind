# InkFind — environment config
# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# --- AI Design Generator (optional) ------------------------------------------
# Without a token, /generate falls back to deterministic placeholder images and
# the app runs fine. Set this to enable REAL image generation via Replicate.
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Model to run. Default is FLUX.1 [schnell] — fast + cheap, up to 4 images/call.
# Swap for any Replicate image model (e.g. a tattoo-specific fine-tune) to
# change the look without touching the app code.
REPLICATE_MODEL=black-forest-labs/flux-schnell
